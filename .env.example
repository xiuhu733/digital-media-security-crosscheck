APP_ENV=development
SEARCH_PROVIDERS=mock
CONTENT_PROVIDER=mock
MAX_SEARCH_RESULTS=5
MAX_EVIDENCE_ITEMS=8
REQUEST_TIMEOUT_SECONDS=60
# Diagnostics: JSONL files, 5 MB per file, 3 rotated backups per worker.
# LOG_DIRECTORY=/absolute/path/to/logs
# Optional redacted model-output preview on parsing errors (up to 2000 characters).
LOG_LLM_RESPONSE_PREVIEW=false
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev
EXA_API_KEY=
EXA_API_URL=https://api.exa.ai

# Optional OpenAI-compatible model for claim understanding
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
BACKUP_LLM_API_KEY=
BACKUP_LLM_API_URL=https://api.openai.com/v1
BACKUP_LLM_MODEL=gpt-4o-mini

# Optional absolute path; default: <project>/data/crosscheck.sqlite3
# DATABASE_PATH=/absolute/path/to/crosscheck.sqlite3
